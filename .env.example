DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sirocash?schema=public"
# Production integration only; never expose custody keys to the browser.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
# Required fixed trusted HTTPS origin in production (no trailing path).
# WEBAUTHN_ORIGIN="https://wallet.example.com"
# Email authentication (server-only; never NEXT_PUBLIC_)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SiroCash <security@your-verified-domain.com>"
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Global hourly email budget guard, in addition to 5/hour/email and 60s cooldown.
AUTH_MAX_EMAILS_PER_HOUR="100"
# Optional PEM CA when required by the database provider; use the provider's authentic certificate.
# Production always verifies TLS certificates. Never set rejectUnauthorized=false.
DATABASE_SSL_CA=""

# Optional: owner-approved support inbox; leave unset until real.
SUPPORT_EMAIL=
# Optional: existing account UUIDs approved for read-only operations. Empty denies everyone.
OPERATIONS_ADMIN_IDS=
# Optional: provision via secret store, >=32 random characters, never commit a real value.
CRON_SECRET=

# Identity intake: disabled until private Cloudflare resources + retention/privacy approval exist.
# No NEXT_PUBLIC_ values; never paste service tokens into chat.
IDENTITY_COLLECTION_ENABLED=false
IDENTITY_WORKER_URL=
IDENTITY_SERVICE_TOKEN=
# Independent >=32 random characters; keep stable to preserve subject mapping.
IDENTITY_SUBJECT_SECRET=
# Legacy fixed-days mode only: integer 1–90; unused in account_lifetime mode.
IDENTITY_RETENTION_DAYS=
# Separate token shared only with the worker's review binding; must differ from intake token.
IDENTITY_REVIEW_TOKEN=
IDENTITY_REVIEWER_IDS=
# Enable only after configuring a reviewer Access/MFA perimeter and access policy.
IDENTITY_REVIEW_ENABLED=false
# Owner-selected policy: retain while the account remains registered (inactivity is not closure).
IDENTITY_RETENTION_POLICY=account_lifetime
# Must be enabled together with a configured CRON_SECRET and verified daily reconciliation.
IDENTITY_LIFECYCLE_ENABLED=false

# Required build-time hosted synthetic + lifecycle preflight before intake activation.
IDENTITY_DEPLOYMENT_CHECK=false

# Explicit fresh v4 consent and a successful live Workers AI preflight are required.
IDENTITY_AI_ENABLED=false

# TronZap: production-only sensitive variables. Never use NEXT_PUBLIC_ names.
TRONZAP_API_TOKEN=
TRONZAP_API_SECRET=
# Read-only balance + energy-price check; no purchases. Disabled by default.
TRONZAP_READ_CHECK=false
