{
  "name": "sirocash-identity",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "sirocash-identity",
      "database_id": "12a1811a-31fe-47c9-9e93-2ac86e7599a4",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  }
}
