{
  "name": "sirocash-identity",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": {"enabled": false},
  "d1_databases": [{"binding":"IDENTITY_DB","database_name":"sirocash-identity","database_id":"REPLACE_WITH_CREATED_D1_ID","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"IDENTITY_DOCUMENTS","bucket_name":"sirocash-identity-private"}],
  "triggers": {"crons":["17 * * * *"]}
}
