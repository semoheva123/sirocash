{
  "name": "sirocash",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "npm run db:verify && npm run identity:deployment-check && next build --webpack",
    "start": "next start -H 0.0.0.0",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "test:api": "node tests/api.mjs",
    "test:ledger": "node tests/ledger.mjs",
    "test": "npm run lint && npm run test:ledger && npm run test:email && npm run test:password && npm run test:copy && npm run test:crypto && npm run test:database && npm run test:database-options && npm run test:email-template && npm run test:account && npm run test:routing && npm run test:settings && npm run test:password-change && npm run test:design && npm run test:account-security && npm run test:reconciliation && npm run test:atelier && npm run test:modern && npm run test:identity",
    "test:email": "node tests/email-schema.mjs",
    "test:password": "node --experimental-strip-types tests/password.mjs",
    "test:copy": "node tests/arabic-copy.mjs",
    "test:crypto": "tsx tests/crypto.ts",
    "test:database": "node tests/database-access.mjs",
    "db:verify": "tsx scripts/verify-database.ts",
    "test:database-options": "tsx tests/database-options.ts",
    "test:email-template": "tsx tests/verification-email.ts",
    "email:preview": "tsx scripts/preview-verification-email.ts",
    "test:account": "tsx tests/account-overview.ts",
    "test:routing": "node tests/account-routing.mjs",
    "test:settings": "tsx tests/account-settings.tsx",
    "test:password-change": "tsx tests/change-password.ts",
    "test:design": "tsx tests/design-system.tsx",
    "test:account-security": "tsx tests/account-security.ts",
    "ops:reconcile": "tsx scripts/reconcile-settlement.ts",
    "test:reconciliation": "tsx tests/reconciliation.ts",
    "test:atelier": "tsx tests/atelier-design.tsx",
    "test:modern": "tsx tests/modern-fintech.tsx",
    "test:identity": "node tests/identity-gateway-readiness.mjs && tsx tests/identity.tsx",
    "identity:deployment-check": "node --conditions=react-server --import tsx scripts/check-identity-deployment.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.35.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "miniflare": "^4.20260730.0",
    "postcss": "^8.5.32",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp",
    "undici": "^7.30.1"
  },
  "engines": {
    "node": "22.x"
  }
}
