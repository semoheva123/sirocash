{
  "name": "sirocash",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "npm run db:verify && next build --webpack",
    "start": "next start -H 0.0.0.0",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "test:api": "node tests/api.mjs",
    "test:ledger": "node tests/ledger.mjs",
    "test": "npm run lint && npm run test:ledger && npm run test:email && npm run test:password && npm run test:copy && npm run test:crypto && npm run test:database && npm run test:database-options && npm run test:email-template && npm run test:account",
    "test:email": "node tests/email-schema.mjs",
    "test:password": "node --experimental-strip-types tests/password.mjs",
    "test:copy": "node tests/arabic-copy.mjs",
    "test:crypto": "tsx tests/crypto.ts",
    "test:database": "node tests/database-access.mjs",
    "db:verify": "tsx scripts/verify-database.ts",
    "test:database-options": "tsx tests/database-options.ts",
    "test:email-template": "tsx tests/verification-email.ts",
    "email:preview": "tsx scripts/preview-verification-email.ts",
    "test:account": "tsx tests/account-overview.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.32",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "engines": {
    "node": "22.x"
  }
}
